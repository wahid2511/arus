{
  "manifest_version": 3,
  "name": "Arus Download Companion",
  "version": "1.0.0",
  "description": "Kirim unduhan dari browser ke aplikasi desktop Arus.",
  "browser_specific_settings": {
    "gecko": {
      "id": "arus-companion@genghero.local",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Arus",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
